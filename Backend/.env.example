# AniRescue Backend — standalone local development
#
# This file is used only when running the Backend outside Docker Compose.
# The root .env is used by docker-compose.yml instead.
#
# Copy this file to .env inside Backend/:
#   cp .env.example .env
#
# Never commit the resulting .env file.

NODE_ENV=development
PORT=3000

# PostgreSQL / Neon
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# RabbitMQ
# For a standalone backend running on the host, use localhost.
# If the backend is running inside Docker Compose, use the root .env instead.
RABBITMQ_URL=amqp://anirescue_user:replace-with-a-strong-local-password@localhost:5672/

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Firebase Admin
# Optional for local development. Provide either a protected service-account
# JSON path or FIREBASE_SERVICE_ACCOUNT_JSON.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Firebase Cloud Storage bucket used for large offline PMTiles packages.
# New default buckets normally use: <PROJECT_ID>.firebasestorage.app

# Frontend origins allowed to call the local API.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# OAuth / social sign-in
# ---------------------------------------------------------------------------
# Public backend origin used to build OAuth callback URLs.
BACKEND_PUBLIC_URL=http://localhost:3000

# Frontend origin used after OAuth completes.
OAUTH_FRONTEND_URL=http://localhost:5173

# Google Cloud Console -> Credentials -> OAuth 2.0 Client ID (Web application)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback

# Meta for Developers -> Facebook Login
FACEBOOK_OAUTH_APP_ID=
FACEBOOK_OAUTH_APP_SECRET=
# Set this to the Graph API version enabled for your Meta app.
FACEBOOK_GRAPH_VERSION=
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oauth/facebook/callback
