NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://...
RABBITMQ_URL=amqps://...
JWT_SECRET=replace-with-at-least-32-random-characters

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Exact frontend origin(s), comma-separated.
CORS_ORIGIN=https://your-frontend.example

LOCATION_FRESHNESS_MINUTES=5
NOTIFICATION_RADIUS_KM=5

# Existing deployments already contain the original schema.
MIGRATIONS_BASELINE_VERSION=5

# Optional: Firebase Admin service-account JSON path.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
