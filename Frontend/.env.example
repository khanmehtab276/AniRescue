# AniRescue Frontend — local development
#
# Vite exposes VITE_* variables to browser code. Never put server secrets here.
#
# Backend API base URL:
# Leave VITE_API_URL unset for normal local development because Vite proxies
# /api to the local backend at http://localhost:3000.
# VITE_API_URL=http://localhost:3000/api

# ---------------------------------------------------------------------------
# Firebase Web / FCM
# ---------------------------------------------------------------------------
# Firebase Console -> Project settings -> Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=anirescue-a5fd7
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Console -> Project settings -> Cloud Messaging ->
# Web configuration -> Web Push certificates
VITE_FIREBASE_VAPID_KEY=

# ---------------------------------------------------------------------------
# Optional map configuration
# ---------------------------------------------------------------------------
# CARTO basemap key, if the current deployment uses one.
VITE_CARTO_API_KEY=

# ---------------------------------------------------------------------------
# Large offline vector maps
# ---------------------------------------------------------------------------
# Optional direct HTTPS map directory override.
# By default AniRescue asks the authenticated backend for a short-lived
# signed Firebase Storage URL for offline-maps/<zone>.pmtiles.
# Example:
# VITE_OFFLINE_MAP_BASE_URL=https://your-map-storage.example.com/anirescue
VITE_OFFLINE_MAP_BASE_URL=
