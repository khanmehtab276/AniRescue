# Backend API base URL. Leave unset in local dev — Vite proxies /api to localhost:3000.
# VITE_API_URL=https://your-backend.example.com/api

# Firebase web app config (Firebase console -> Project settings -> Your apps).
# All six are required for push notifications; if any is missing the
# Profile page shows "not set up for this deployment" instead of failing.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push certificate key pair (Firebase console -> Project settings ->
# Cloud Messaging -> Web configuration -> Generate key pair).
VITE_FIREBASE_VAPID_KEY=

# Optional CARTO basemap key (restrict it to your production domain)
VITE_CARTO_API_KEY=
