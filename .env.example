# Docker Compose / local development configuration
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_URL=amqp://guest:change-me@rabbitmq:5672
DATABASE_URL=postgresql://user:password@host/database
JWT_SECRET=replace-with-a-long-random-secret
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOCATION_FRESHNESS_MINUTES=5
NOTIFICATION_RADIUS_KM=5

# Host path to the local Firebase Admin service-account JSON.
# Keep the actual JSON inside ./secrets/ and never commit it.
FIREBASE_SERVICE_ACCOUNT_HOST_PATH=./secrets/firebase-service-account.json
