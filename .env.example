# AniRescue — local development environment
#
# Copy this file to .env in the repository root:
#   cp .env.example .env
#
# This file is used by the root docker-compose.yml.
# Keep real credentials in .env only. Never commit .env.

# ---------------------------------------------------------------------------
# Local RabbitMQ
# ---------------------------------------------------------------------------
# Used by the local backend and YOLO worker containers.
# Do not use the production CloudAMQP URL for the normal full-local stack.
RABBITMQ_DEFAULT_USER=anirescue_user
RABBITMQ_DEFAULT_PASS=replace-with-a-strong-local-password
RABBITMQ_URL=amqp://anirescue_user:replace-with-a-strong-local-password@rabbitmq:5672/

# ---------------------------------------------------------------------------
# PostgreSQL / Neon
# ---------------------------------------------------------------------------
# A development Neon database can be used instead of a local PostgreSQL
# container. The backend and YOLO worker both use this connection.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ---------------------------------------------------------------------------
# Backend authentication
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-at-least-32-random-characters

# ---------------------------------------------------------------------------
# Cloudinary
# ---------------------------------------------------------------------------
# The browser uploads rescue images to Cloudinary and the backend/worker
# use the configured cloud for signed uploads and image processing.
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ---------------------------------------------------------------------------
# Firebase Admin / push notifications
# ---------------------------------------------------------------------------
# For local Docker Compose, provide the Firebase Admin service-account JSON
# as a single-line JSON string. Do not commit the real value.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# Gemini API — worker-only
# ---------------------------------------------------------------------------
# Create the API key in Google AI Studio. Never expose this in the frontend
# and never commit the real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Local Vite development server.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

