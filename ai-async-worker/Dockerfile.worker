# --- Stage 1: Build the isolated runtime environment ---
FROM python:3.10-slim AS builder

WORKDIR /build

ENV PATH="/opt/venv/bin:$PATH" \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DEFAULT_TIMEOUT=600 \
    PYTHONDONTWRITEBYTECODE=1

# Keep the Python environment isolated so only the final venv is copied
# into the small runtime image.
RUN python -m venv /opt/venv

# Install PyTorch's runtime dependencies from normal PyPI.
# The PyTorch index has inconsistent package metadata for some dependencies,
# so it must not be used as the dependency resolver's primary index.
RUN pip install --index-url https://pypi.org/simple \
    filelock \
    fsspec \
    jinja2 \
    networkx \
    sympy \
    typing-extensions

# Install CPU-only PyTorch wheels without resolving their dependencies
# through the PyTorch index. The longer pip timeout is intentional because
# the CPU wheel is large and may download slowly.
RUN pip install --no-deps \
    --timeout 600 \
    --index-url https://download.pytorch.org/whl/cpu \
    torch torchvision

# Install the pinned Ultralytics package without letting it replace the
# CPU-only PyTorch stack.
RUN pip install --no-deps ultralytics==8.4.90

# Install the remaining application + Ultralytics runtime dependencies.
COPY requirements.txt ./requirements.txt
RUN grep -v '^ultralytics==' requirements.txt > /tmp/requirements-runtime.txt \
    && pip install --index-url https://pypi.org/simple -r /tmp/requirements-runtime.txt \
    && rm -f /tmp/requirements-runtime.txt

# --- Stage 2: Minimal production runtime ---
FROM python:3.10-slim AS runtime

WORKDIR /app

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    YOLO_CONFIG_DIR=/tmp/Ultralytics \
    MPLCONFIGDIR=/tmp/matplotlib \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    VECLIB_MAXIMUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1

# OpenCV and PyTorch CPU runtime libraries.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libglib2.0-0 \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Copy only the prepared Python environment from the builder.
COPY --from=builder /opt/venv /opt/venv

# Create the non-root runtime user before copying application files.
RUN addgroup --system --gid 65532 appgroup \
    && adduser --system --uid 65532 --ingroup appgroup appuser \
    && mkdir -p /tmp/Ultralytics /tmp/matplotlib \
    && chown -R 65532:65532 /tmp/Ultralytics /tmp/matplotlib

COPY --chown=65532:65532 . .

USER 65532:65532

CMD ["python", "worker.py"]
